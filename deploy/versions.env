# 5G 元件版本鎖定（本專案自行建置，不依賴培訓營映像檔）
#
# 為什麼自己 pin 版本：
#   1. 決賽須繳交完整程式碼供評審辨識原創性，「能重現」本身就是證據；
#   2. 不受制於別人的映像檔，環境壞了可以一行指令重建；
#   3. 我們的情境是雙 MEC 節點 + 聯邦蒸餾，教材的單一 App 示範不涵蓋，
#      設定本來就得自己寫。
#
# 元件本身仍採用競賽平台指定的上游專案（free5GC / UERANSIM / OAI-MEP）——
# 初賽評分「系統架構完整性（含競賽平台關聯性）」佔 40%，且 SPEC §2 Q6 的
# MEC 論證建立在 ETSI MEC 003/011 的 Service Registry 與 MEP Gateway 上，
# 那是 OAI-MEP 提供的能力。自己換掉元件會把這兩塊一起打掉。
#
# 改版本前請先讀 docs/platform-notes.md §6，並在改完後重跑對應的 install_*.sh。

# free5GC 核心網路。v4.1.0 與教材環境一致（教材 p.54 截圖：v4.1.0 / go1.24.5）
FREE5GC_VERSION="v4.1.0"
FREE5GC_REPO="https://github.com/free5gc/free5gc.git"

# gtp5g GTP-U kernel module。
# 官方支援 kernel 5.4–7.0.x，我們的 guest 是 5.15.0-191，在範圍內。
# 預設取 0.9.x 線的最後一版：與 free5GC v4.1.0 同期，netlink API 相容性最穩。
# 若 UPF 啟動時抱怨 gtp5g 版本，改試 v0.10.2 並記錄於 platform-notes.md §7。
# 實測：v0.9.16 在 kernel 5.15.0-191 上編譯並載入成功（115/09/23，VM1）
GTP5G_VERSION="v0.9.16"
GTP5G_REPO="https://github.com/free5gc/gtp5g.git"

# UERANSIM UE/gNB 模擬器。v3.2.7 與教材一致（教材 p.55 截圖）
UERANSIM_VERSION="v3.2.7"
UERANSIM_REPO="https://github.com/aligungr/UERANSIM.git"

# Go：free5GC v4.1.0 需要 1.24（release note「Chore/upgrade go 1.24」）
# apt 只有 1.18，必須從上游裝
GO_VERSION="1.24.5"
GO_URL_BASE="https://go.dev/dl"
# checksum 不寫死在這裡：install_go.sh 會從 go.dev 的官方 JSON 取得對應版本的
# sha256 再比對下載檔。寫死的 hash 一旦版本改動就會變成謊話，不如即時取得。

# MongoDB：free5GC 的用戶資料庫。Ubuntu 22.04 官方庫已不含 mongodb，
# 需加上游 repo。7.0 為 jammy 上的穩定線。
MONGODB_VERSION="7.0"

# OAI-MEP（MEC Platform：MEP Gateway/Kong + Discovery and Service Registry）
# 正確路徑多一層 oai-mec（EURECOM GitLab）。docker-compose 會拉
# oaisoftwarealliance/oai-mep 等預建映像，不需自行編譯。
OAI_MEP_REPO="https://gitlab.eurecom.fr/oai/orchestration/oai-mec/oai-mep.git"
# 實測：上游只有 master / development / carota_https_support，沒有 develop。
# 取 master（預設分支）。commit 2881cad 為 115/09/23 實測可用的版本。
OAI_MEP_REF="master"
