# 由 deploy/gen_topology_env.py 從 config.yaml 產生，請勿手動編輯。
# 要改位址請改 config.yaml 的 network / nodes 區，再重跑產生器。

VM1_HOSTONLY="192.168.113.131"   # free5GC + OAI-MEP + MEC Apps
VM2_HOSTONLY="192.168.113.132"   # UERANSIM + SUMO + UE
N6_APP="172.16.6.10"        # MEC App 綁定位址
N6_GW="172.16.6.100"       # MEP Gateway 對外入口
UE_IF="uesimtun0"          # UE tun 介面

# 各 MEC 節點的 port（SPEC §3.3）
NODE_A_PORT="5002"
NODE_B_PORT="5003"

# 健康檢查與展示面板
HEALTH_PORT="5000"
DASH_PORT="5010"
